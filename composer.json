{
    "name": "nanofelis/json-rpc-bundle",
    "type": "symfony-bundle",
    "description": "This bundle provides a JSON RPC 2.0 implementation for Symfony",
    "keywords": [
        "json-rpc",
        "api",
        "symfony"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriel Soullier",
            "email": "gabriel.soullier@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/property-access": "^6.4|^7.0|^8.0",
        "symfony/serializer": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4|^7.0|^8.0",
        "phpstan/phpstan-symfony": "^1.4",
        "symfony/browser-kit": "^6.4|^7.0|^8.0",
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/phpstan": "^1.12",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Nanofelis\\JsonRpcBundle\\": "src"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Nanofelis\\JsonRpcBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.1-dev"
        }
    }
}
